# LawLens — Environment Configuration Example
# Copy this file to .env.local and add your server-side keys.
# NEVER commit .env.local to version control or expose API keys to the browser.

# Groq API Key (Server-Side Only)
GROQ_API_KEY=

# Groq Primary and Fallback Models
GROQ_PRIMARY_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODEL=openai/gpt-oss-20b
